      "parts": [
        {
          "ro": "$v(q)$",
          "en": "$v(q)$"
        },
        {
          "ro": "$v(r)$",
          "en": "$v(r)$"
        },
        {
          "ro": "$v(\\overline{q} \\rightarrow (p \\land r))$",
          "en": "$v(\\overline{q} \\rightarrow (p \\land r))$"
        }
      ],
      "accept": [
        "1; 0; 1"
      ],
      "show": "$v(p \\vee q) = 1$ și $v(r) = 0$; cum $v(p) = 0$, rezultă $v(q) = 1$; $v(\\overline{q} \\rightarrow (p \\land r)) = v(0 \\rightarrow 0) = 1$"
    },

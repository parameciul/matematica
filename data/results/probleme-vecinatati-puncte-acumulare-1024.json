    "5": {
      "check": false,
      "why": "proof",
      "show": "a) $(a, + \\infty) \\subset V_{1} \\cap V_{2}$ pentru $a = \\max\\left\\{ a_{1},a_{2} \\right\\}$. b) Intersecția este $\\left\\{ 0 \\right\\}$, care nu conține niciun interval $( - \\varepsilon,\\varepsilon)$"
    },
    "6": {
      "kind": "text",
      "show": "$\\frac{2n - 1}{n + 1} = 2 - \\frac{3}{n + 1}$; $\\min A = - 1$ (pentru $n = 0$), $\\sup A = 2$ (nu este atins), $A' = \\left\\{ 2 \\right\\}$",
      "accept": [
        "-1;2;{2}",
        "-1,2,{2}"
      ],
      "hint": {
        "ro": "în ordinea $\\min A$; $\\sup A$; $A'$",
        "en": "in the order $\\min A$; $\\sup A$; $A'$"
      }
    },
    "7": {
      "check": false,
      "why": "proof",
      "show": "Pentru $n \\geq 4$, $n^{2} - 3n \\geq n$, deci $A$ nu este majorată"
    },
    "9": {
